    {
        "id": "b055000000000056",
        "type": "function",
        "z": "b055000000000001",
        "name": "yaw -> 8-point compass",
        "func": "// Heading 0..360 deg, clockwise increases (BNO055 data sheet Table 3-13)\n// 8 sectors of 45 deg: N 337.5..22.5, NE 22.5..67.5, E, SE, S, SW, W, NW\nconst yaw = Number(msg.payload);\nif (!Number.isFinite(yaw)) {\n    return null;\n}\nconst heading = ((yaw % 360) + 360) % 360;\nconst dirs = ['N', 'NE', 'E', 'SE', 'S', 'SW', 'W', 'NW'];\nmsg.payload = dirs[Math.floor((heading + 22.5) / 45) % 8] + ' (' + heading.toFixed(1) + '\\u00b0)';\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 960,
        "y": 500,
        "wires": [
