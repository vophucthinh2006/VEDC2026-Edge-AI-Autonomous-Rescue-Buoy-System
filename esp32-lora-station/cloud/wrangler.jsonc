{
  "name": "mliot-redgescue",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // Giao diện web nằm ở ../web, Worker chạy trước để định tuyến API và kiểm tra phiên đăng nhập
  "assets": { "directory": "../web", "binding": "ASSETS", "run_worker_first": true },
  // Client ID của Google OAuth (giá trị công khai). Đặt sau khi tạo trong Google Cloud Console.
  "vars": { "GOOGLE_CLIENT_ID": "374685753463-41c974p9nm6udp00ftv69s956t7eioct.apps.googleusercontent.com" },
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }]
}
