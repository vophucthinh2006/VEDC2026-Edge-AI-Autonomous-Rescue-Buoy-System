# Tram bo la client HTTPS gui du lieu len Cloudflare: can bundle chung chi de xac thuc TLS
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
# 4G Cat.1 du phong (cellular.c): esp_modem can PPP trong lwIP.
# LCP echo moi 10 s, hong 3 lan lien tiep thi coi la mat ket noi va quay so lai.
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_ENABLE_LCP_ECHO=y
CONFIG_LWIP_LCP_ECHOINTERVAL=10
CONFIG_LWIP_LCP_MAXECHOFAILS=3
