<?xml version="1.0" ?>
<!--
  A tiled house flooded to the eaves.
  Built from boxes, static: no hydrodynamics, so it costs the simulator nothing.
  Origin at the water level in the middle of the footprint, ridge along x.
  Walls reach 0.5 m above the water, eaves 0.36 m, ridge 1.67 m: the buoy's
  LiDAR, 0.37 m above the water, sees the walls and the roof just above the eaves.
-->
<sdf version="1.9">
  <model name="flooded_house">
    <static>true</static>
    <link name="house">
      <visual name="walls">
        <pose>0 0 -1.000 0 0 0</pose>
        <geometry><box><size>7.0 5.0 3.0</size></box></geometry>
        <material><ambient>0.85 0.8 0.68 1</ambient><diffuse>0.85 0.8 0.68 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
      </visual>
      <visual name="gable">
        <pose>0 0 0.791 0 0 0</pose>
        <geometry><box><size>7.0 2.5 0.583</size></box></geometry>
        <material><ambient>0.85 0.8 0.68 1</ambient><diffuse>0.85 0.8 0.68 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
      </visual>
      <visual name="roof_north">
        <pose>0 1.400 1.013 -0.4363 0 0</pose>
        <geometry><box><size>7.6 3.089 0.08</size></box></geometry>
        <material><ambient>0.62 0.2 0.14 1</ambient><diffuse>0.62 0.2 0.14 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
      </visual>
      <visual name="roof_south">
        <pose>0 -1.400 1.013 0.4363 0 0</pose>
        <geometry><box><size>7.6 3.089 0.08</size></box></geometry>
        <material><ambient>0.62 0.2 0.14 1</ambient><diffuse>0.62 0.2 0.14 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
      </visual>
      <collision name="walls">
        <pose>0 0 -1.000 0 0 0</pose>
        <geometry><box><size>7.0 5.0 3.0</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
