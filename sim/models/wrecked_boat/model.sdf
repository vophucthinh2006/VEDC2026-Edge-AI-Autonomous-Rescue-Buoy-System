<?xml version="1.0" ?>
<!--
  A wooden fishing boat the storm drove ashore: 8 m long, heeled 24 deg, bow up. Static, origin
  at the water level under the middle of the hull. It stands 1 to 2 m out of the water.
-->
<sdf version="1.9">
  <model name="wrecked_boat">
    <static>true</static>
    <link name="link">
      <visual name="hull">
        <pose>0 0 0.15 0.42 -0.10 0</pose>
        <geometry><box><size>8.0 2.4 1.5</size></box></geometry>
        <material><ambient>0.1 0.3 0.55 1</ambient><diffuse>0.1 0.3 0.55 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
      </visual>
      <collision name="hull">
        <pose>0 0 0.15 0.42 -0.10 0</pose>
        <geometry><box><size>8.0 2.4 1.5</size></box></geometry>
      </collision>
      <visual name="band">
        <pose>0 0 0.62 0.42 -0.10 0</pose>
        <geometry><box><size>8.05 2.45 0.2</size></box></geometry>
        <material><ambient>0.7 0.15 0.12 1</ambient><diffuse>0.7 0.15 0.12 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
      </visual>
      <visual name="bow">
        <pose>4.3 0 0.45 0.42 -0.10 0.785</pose>
        <geometry><box><size>1.7 1.7 1.5</size></box></geometry>
        <material><ambient>0.1 0.3 0.55 1</ambient><diffuse>0.1 0.3 0.55 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
      </visual>
      <collision name="bow">
        <pose>4.3 0 0.45 0.42 -0.10 0.785</pose>
        <geometry><box><size>1.7 1.7 1.5</size></box></geometry>
      </collision>
      <visual name="cabin">
        <pose>-2.4 0.45 1.25 0.42 -0.10 0</pose>
        <geometry><box><size>2.2 1.6 1.2</size></box></geometry>
        <material><ambient>0.9 0.9 0.86 1</ambient><diffuse>0.9 0.9 0.86 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
      </visual>
      <collision name="cabin">
        <pose>-2.4 0.45 1.25 0.42 -0.10 0</pose>
        <geometry><box><size>2.2 1.6 1.2</size></box></geometry>
      </collision>
      <visual name="mast">
        <pose>-1.2 0.9 2.3 0.42 -0.10 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>2.4</length></cylinder></geometry>
        <material><ambient>0.36 0.25 0.16 1</ambient><diffuse>0.36 0.25 0.16 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
      </visual>
    </link>
  </model>
</sdf>
