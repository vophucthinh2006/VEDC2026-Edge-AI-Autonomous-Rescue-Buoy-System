<?xml version="1.0" ?>
<!--
  A single-storey house after the typhoon: the roof is gone but for the ridge, three rafters and
  one sheet of tin; the walls stand in 1.2 m of water, 1.9 m of them above it. Built from boxes,
  static. Origin at the water level in the middle of the 6 x 4.5 m footprint, the door in the
  south wall (-y). The buoy's LiDAR, 0.37 m above the water, sees the walls.
-->
<sdf version="1.9">
  <model name="storm_house">
    <static>true</static>
    <link name="link">
