<?xml version="1.0" ?>
<!--
  RedgeSCUE buoy. The look is the team's CAD model, cut into hull, pods and camera
  (meshes/*.stl, made from sim/Thuyen.ETL.STL by sim/tools/cad_to_mesh.py); thrusters and
  camera sit where the CAD has them, except the front motor, lowered 0.09 m to get its
  propeller under water. Mass, buoyancy and thrust are set here, not taken from the meshes.
  The link poses below must match the link origins in cad_to_mesh.py.

  Catamaran 1.10 m long, 0.60 m wide. Model frame: x forward, y port, z up,
  origin on the centreline at the design waterline, 0.05 m above the hull bottoms.

  Propulsion, as the STM32 firmware drives it (App/manual.c, actuators.c):
    rear left / rear right  thruster on a steerable pod, steered together
    front (centre)          bidirectional thruster on a pod that steers the
                            opposite way to the rear ones (four-wheel style)

  ArduPilot outputs (params/vedc_buoy.parm), control channel = SERVOn - 1:
    SERVO1 ThrottleLeft  (73) -> rear left thrust
    SERVO2 GroundSteering(26) -> both rear pods
    SERVO3 ThrottleRight (74) -> rear right thrust
    SERVO4 Throttle      (70) -> front thrust, 1500 us = stop
    SERVO5 GroundSteering(26), reversed -> front pod

  From the team: 15 kg all up, 12 V 5600 mAh battery, DS51150-12V pod servos
  (0.21 s per 60 deg at 12 V), SG90 camera pan servo, OV9726 camera, Pi 4.

  Still guessed (see sim/README.md): hull section 0.14 x 0.20 m, thrust
  +-15 N per rear motor and +-10 N front (motor and prop unknown), pods
  +-45 deg over 1000..2000 us (the DS51150 comes in 180 and 270 deg versions),
  lidar range (LDS-008, a robot-vacuum unit, no datasheet found).
-->
<sdf version="1.9">
  <model name="vedc_buoy">

    <!-- ===================== hull ===================== -->
    <link name="base_link">
      <inertial>
        <pose>0 0 0.02 0 0 0</pose>
        <mass>15.0</mass>
        <!-- solid box 1.10 x 0.60 x 0.25 m -->
        <inertia>
          <ixx>0.528</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.591</iyy>
          <iyz>0</iyz>
          <izz>1.963</izz>
        </inertia>
      </inertial>

      <!-- Buoyancy and drag come from these collision shapes, not from the mesh: two boxes with
           the footprint of the CAD hulls (0.132 m wide, 0.235 m off the centreline). -->
      <collision name="hull_port_collision">
        <pose>0 0.23 0.05 0 0 0</pose>
        <geometry><box><size>1.10 0.14 0.20</size></box></geometry>
      </collision>
      <collision name="hull_stbd_collision">
        <pose>0 -0.23 0.05 0 0 0</pose>
        <geometry><box><size>1.10 0.14 0.20</size></box></geometry>
      </collision>

      <visual name="cad_visual">
        <geometry><mesh><uri>model://vedc_buoy/meshes/hull.stl</uri></mesh></geometry>
        <material>
          <ambient>0.95 0.45 0.10 1</ambient>
          <diffuse>0.95 0.45 0.10 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <!-- The front motor hangs 0.09 m lower than in the CAD: this strut fills the gap up to the tunnel roof. -->
      <visual name="front_strut_visual">
        <pose>0.21 0 0.085 0 0 0</pose>
        <geometry><box><size>0.075 0.03 0.09</size></box></geometry>
        <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <!-- Flight controller IMU, in the electronics box. On the hull link itself:
           a light IMU link on a fixed joint picked up solver jitter. -->
      <sensor name="imu_sensor" type="imu">
        <pose degrees="true">-0.10 0 0.20 180 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000.0</update_rate>
      </sensor>
    </link>

    <!-- ===================== pods ===================== -->
    <!-- Each pod: a yaw joint (servo) and a thruster joint along the pod's x. The pod links show
         the CAD's strut, motor and propeller, and turn with the servo; the propeller links have no
         visual. Positions measured on the CAD: rear propellers 0.10 m across, centred 0.115 m below
         the origin. The front one, 0.12 m across in the tunnel between the hulls, is drawn in the
         CAD with its centre only 0.02 m below the origin, half out of the water; here it is
         0.09 m lower. -->
    <link name="pod_rear_left_link">
      <pose>-0.40 0.234 -0.115 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia><ixx>1e-4</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-4</iyy><iyz>0</iyz><izz>1e-4</izz></inertia>
      </inertial>
      <visual name="cad_visual">
        <geometry><mesh><uri>model://vedc_buoy/meshes/pod_rear_left.stl</uri></mesh></geometry>
        <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
    </link>
    <joint name="pod_rear_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>pod_rear_left_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-0.8</lower><upper>0.8</upper><effort>1e6</effort></limit>
        <dynamics><damping>0.05</damping></dynamics>
      </axis>
    </joint>
    <link name="prop_rear_left_link">
      <pose>-0.43 0.234 -0.115 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <!-- far above a real prop, as in the BlueBoat model: a light spinning link destabilises the solver -->
        <inertia><ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.1</iyy><iyz>0</iyz><izz>0.1</izz></inertia>
      </inertial>
    </link>
    <joint name="prop_rear_left_joint" type="revolute">
      <parent>pod_rear_left_link</parent>
      <child>prop_rear_left_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.02</damping></dynamics>
      </axis>
    </joint>

    <link name="pod_rear_right_link">
      <pose>-0.40 -0.234 -0.115 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia><ixx>1e-4</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-4</iyy><iyz>0</iyz><izz>1e-4</izz></inertia>
      </inertial>
      <visual name="cad_visual">
        <geometry><mesh><uri>model://vedc_buoy/meshes/pod_rear_right.stl</uri></mesh></geometry>
        <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
    </link>
    <joint name="pod_rear_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>pod_rear_right_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-0.8</lower><upper>0.8</upper><effort>1e6</effort></limit>
        <dynamics><damping>0.05</damping></dynamics>
      </axis>
    </joint>
    <link name="prop_rear_right_link">
      <pose>-0.43 -0.234 -0.115 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <!-- far above a real prop, as in the BlueBoat model: a light spinning link destabilises the solver -->
        <inertia><ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.1</iyy><iyz>0</iyz><izz>0.1</izz></inertia>
      </inertial>
    </link>
    <joint name="prop_rear_right_joint" type="revolute">
      <parent>pod_rear_right_link</parent>
      <child>prop_rear_right_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.02</damping></dynamics>
      </axis>
    </joint>

    <link name="pod_front_link">
      <pose>0.19 0 -0.11 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia><ixx>1e-4</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-4</iyy><iyz>0</iyz><izz>1e-4</izz></inertia>
      </inertial>
      <visual name="cad_visual">
        <geometry><mesh><uri>model://vedc_buoy/meshes/pod_front.stl</uri></mesh></geometry>
        <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
    </link>
    <joint name="pod_front_joint" type="revolute">
      <parent>base_link</parent>
      <child>pod_front_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-0.8</lower><upper>0.8</upper><effort>1e6</effort></limit>
        <dynamics><damping>0.05</damping></dynamics>
      </axis>
    </joint>
    <link name="prop_front_link">
      <pose>0.16 0 -0.11 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <!-- far above a real prop, as in the BlueBoat model: a light spinning link destabilises the solver -->
        <inertia><ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.1</iyy><iyz>0</iyz><izz>0.1</izz></inertia>
      </inertial>
    </link>
    <joint name="prop_front_joint" type="revolute">
      <parent>pod_front_link</parent>
      <child>prop_front_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.02</damping></dynamics>
      </axis>
    </joint>

    <!-- ===================== sensors ===================== -->
    <!-- The CAD model has no LiDAR yet. It stays on a short mast on the roof (0.26 m), its scan
         plane at 0.37 m: above the camera (0.305 m), so the bow sector is not shadowed, and above
         the tip of the antenna (0.355 m), which at 0.35 m showed up as an obstacle 0.3 m astern. -->
    <link name="sensor_mast_link">
      <pose>0.30 0 0.32 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia><ixx>1e-4</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-4</iyy><iyz>0</iyz><izz>1e-4</izz></inertia>
      </inertial>
      <visual name="mast_visual">
        <pose>0 0 -0.02 0 0 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.08</length></cylinder></geometry>
        <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <!-- The LiDAR unit, about the size of the LDS-008: its top stays below the scan plane. -->
      <visual name="lidar_visual">
        <pose>0 0 0.03 0 0 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <!-- LDS-008 robot-vacuum lidar: 360 points per turn, about 5 turns per second
           (figures of its sibling LDS-006). The 8 m range is not confirmed for this unit. -->
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0.05 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>5</update_rate>
        <topic>vedc_buoy/lidar</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range><min>0.15</min><max>8.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise>
        </lidar>
      </sensor>
    </link>
    <joint name="sensor_mast_joint" type="fixed">
      <parent>base_link</parent>
      <child>sensor_mast_link</child>
    </joint>

    <!-- OV9726 camera on an SG90 pan servo, on the bow box where the CAD has it. The link shows
         the CAD's camera body and pans with the servo. -->
    <link name="camera_link">
      <pose>0.41 0 0.295 0 0 0</pose>
      <inertial>
        <mass>0.03</mass>
        <inertia><ixx>1e-4</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-4</iyy><iyz>0</iyz><izz>1e-4</izz></inertia>
      </inertial>
      <visual name="cad_visual">
        <geometry><mesh><uri>model://vedc_buoy/meshes/camera.stl</uri></mesh></geometry>
        <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <!-- OV9726 with the team's 60 deg lens. Horizontal FOV must match
           camera.horizontal_fov_deg in the Pi's settings.yaml; at 4:3 that is 46.8 deg vertical. -->
      <sensor name="camera" type="camera">
        <pose>0.02 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <topic>vedc_buoy/camera</topic>
        <camera>
          <horizontal_fov>1.0472</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>200</far></clip>
        </camera>
      </sensor>
    </link>
    <!-- Axis points down so a positive angle pans right, the convention of
         Rasp_Pi/modules/perception.py track_pan and of the CAM packet. -->
    <joint name="camera_pan_joint" type="revolute">
      <parent>sensor_mast_link</parent>
      <child>camera_link</child>
      <axis>
        <xyz>0 0 -1</xyz>
        <limit><lower>-1.5708</lower><upper>1.5708</upper><effort>1e6</effort></limit>
        <dynamics><damping>0.01</damping></dynamics>
      </axis>
    </joint>

    <!-- ===================== plugins ===================== -->
    <plugin name="gz::sim::systems::JointStatePublisher" filename="gz-sim-joint-state-publisher-system"/>
    <plugin name="gz::sim::systems::OdometryPublisher" filename="gz-sim-odometry-publisher-system">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
    </plugin>

    <!-- Thrusters: cmd_thrust in newtons along each pod's x axis. -->
    <plugin name="gz::sim::systems::Thruster" filename="gz-sim-thruster-system">
      <namespace>vedc_buoy</namespace>
      <joint_name>prop_rear_left_joint</joint_name>
      <thrust_coefficient>0.02</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.06</propeller_diameter>
      <velocity_control>0</velocity_control>
      <use_angvel_cmd>0</use_angvel_cmd>
    </plugin>
    <plugin name="gz::sim::systems::Thruster" filename="gz-sim-thruster-system">
      <namespace>vedc_buoy</namespace>
      <joint_name>prop_rear_right_joint</joint_name>
      <thrust_coefficient>0.02</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.06</propeller_diameter>
      <velocity_control>0</velocity_control>
      <use_angvel_cmd>0</use_angvel_cmd>
    </plugin>
    <plugin name="gz::sim::systems::Thruster" filename="gz-sim-thruster-system">
      <namespace>vedc_buoy</namespace>
      <joint_name>prop_front_joint</joint_name>
      <thrust_coefficient>0.02</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.06</propeller_diameter>
      <velocity_control>0</velocity_control>
      <use_angvel_cmd>0</use_angvel_cmd>
    </plugin>

    <!-- Pod servos (DS51150-12V, 0.21 s per 60 deg = 5 rad/s): position commands in radians. -->
    <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
      <joint_name>pod_rear_left_joint</joint_name>
      <topic>/model/vedc_buoy/joint/pod_rear_left_joint/cmd_pos</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>12</p_gain>
      <cmd_max>5</cmd_max>
      <cmd_min>-5</cmd_min>
    </plugin>
    <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
      <joint_name>pod_rear_right_joint</joint_name>
      <topic>/model/vedc_buoy/joint/pod_rear_right_joint/cmd_pos</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>12</p_gain>
      <cmd_max>5</cmd_max>
      <cmd_min>-5</cmd_min>
    </plugin>
    <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
      <joint_name>pod_front_joint</joint_name>
      <topic>/model/vedc_buoy/joint/pod_front_joint/cmd_pos</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>12</p_gain>
      <cmd_max>5</cmd_max>
      <cmd_min>-5</cmd_min>
    </plugin>

    <!-- Camera pan (SG90, about 0.1 s per 60 deg = 10 rad/s): angle in radians, positive right.
         On the boat the Blue Pill drives this servo for the Pi; here the Pi code publishes the topic. -->
    <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
      <joint_name>camera_pan_joint</joint_name>
      <topic>/model/vedc_buoy/joint/camera_pan_joint/cmd_pos</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>20</p_gain>
      <cmd_max>10</cmd_max>
      <cmd_min>-10</cmd_min>
    </plugin>

    <plugin name="gz::sim::systems::Hydrodynamics" filename="gz-waves1-hydrodynamics-system">
      <enable>vedc_buoy::base_link</enable>
      <hydrodynamics>
        <damping_on>1</damping_on>
        <viscous_drag_on>1</viscous_drag_on>
        <pressure_drag_on>1</pressure_drag_on>
      </hydrodynamics>
    </plugin>

    <!--
      ArduPilot link. A COMMAND control publishes (pwm_norm + offset) * multiplier
      on cmd_topic, pwm_norm = (pwm - servo_min) / (servo_max - servo_min).
      offset -0.5 makes 1500 us the zero.
    -->
    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <imuName>base_link::imu_sensor</imuName>

      <!-- SERVO1 ThrottleLeft: +-15 N -->
      <control channel="0">
        <jointName>prop_rear_left_joint</jointName>
        <multiplier>30</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/vedc_buoy/joint/prop_rear_left_joint/cmd_thrust</cmd_topic>
      </control>
      <!-- SERVO2 GroundSteering: rear pods, +-45 deg; positive (bow right) turns them anticlockwise -->
      <control channel="1">
        <jointName>pod_rear_left_joint</jointName>
        <multiplier>1.5708</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/vedc_buoy/joint/pod_rear_left_joint/cmd_pos</cmd_topic>
      </control>
      <control channel="1">
        <jointName>pod_rear_right_joint</jointName>
        <multiplier>1.5708</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/vedc_buoy/joint/pod_rear_right_joint/cmd_pos</cmd_topic>
      </control>
      <!-- SERVO3 ThrottleRight: +-15 N -->
      <control channel="2">
        <jointName>prop_rear_right_joint</jointName>
        <multiplier>30</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/vedc_buoy/joint/prop_rear_right_joint/cmd_thrust</cmd_topic>
      </control>
      <!-- SERVO4 Throttle: front motor, +-10 N, 1500 us stop -->
      <control channel="3">
        <jointName>prop_front_joint</jointName>
        <multiplier>20</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/vedc_buoy/joint/prop_front_joint/cmd_thrust</cmd_topic>
      </control>
      <!-- SERVO5 GroundSteering reversed: front pod, opposite to the rear ones -->
      <control channel="4">
        <jointName>pod_front_joint</jointName>
        <multiplier>1.5708</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/vedc_buoy/joint/pod_front_joint/cmd_pos</cmd_topic>
      </control>
    </plugin>
  </model>
</sdf>
