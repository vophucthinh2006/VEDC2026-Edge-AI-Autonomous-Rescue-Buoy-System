<?xml version="1.0"?>
<model>
  <name>VEDC buoy</name>
  <version>2.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>VEDC 2026 team</name>
  </author>

  <description>
    RedgeSCUE rescue buoy for ArduPilot SITL: catamaran 1.10 x 0.60 m, two
    steerable rear thrusters and a bidirectional centre front thruster on a pod
    that steers the opposite way. Parametric box hulls until the CAD meshes are
    added. Bow sensor mast with the Pi camera (vedc_buoy/camera) and an
    LD14-like 2D lidar (vedc_buoy/lidar). Hydrodynamics from asv_wave_sim.
  </description>
</model>
