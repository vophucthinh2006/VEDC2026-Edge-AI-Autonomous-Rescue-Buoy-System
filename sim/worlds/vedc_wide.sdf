<?xml version="1.0" ?>
<!--
  Open flood water for the fleet comparison (sim/tools/fleet_compare.py, area x 0..60 m, y -18..18 m):
  the waves, physics and buoy of vedc_lake.sdf, four marker buoys as obstacles, and eight people in
  the water spread over the area, about 2.5 times the street of vedc_central.sdf. No houses: the
  question here is how a fleet shares a wide area, not how it gets along a street.
-->
<sdf version="1.9">
  <world name="vedc_wide">
    <physics name="2ms" type="ignore">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.6 0.75 0.9</background>
      <sky></sky>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.6 0.6 0.6 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <pose>0 0 0 0 0 0</pose>
      <uri>model://vedc_waves</uri>
    </include>

    <include>
      <name>vedc_buoy</name>
      <pose>0 0 0 0 0 0</pose>
      <uri>model://vedc_buoy</uri>
    </include>

    <!-- Obstacles for the LiDAR, away from the people. -->
    <include><name>marker_1</name><pose>10 -4 0 0 0 0</pose><uri>model://spherical_buoy</uri></include>
    <include><name>marker_2</name><pose>25 12 0 0 0 0</pose><uri>model://spherical_buoy</uri></include>
    <include><name>marker_3</name><pose>40 2 0 0 0 0</pose><uri>model://spherical_buoy</uri></include>
    <include><name>marker_4</name><pose>48 -14 0 0 0 0</pose><uri>model://spherical_buoy</uri></include>

    <!-- People in the water. The names start victim_ for fleet_compare.py. -->
    <include><name>victim_w1</name><pose>14.0 10.0 0.0 0 0 -1.5708</pose><uri>model://victim_person</uri></include>
    <include><name>victim_w2</name><pose>20.0 -13.0 0.0 0 0 0.0</pose><uri>model://victim_person</uri></include>
    <include><name>victim_w3</name><pose>29.0 3.0 0.0 0 0 1.5708</pose><uri>model://victim_person</uri></include>
    <include><name>victim_w4</name><pose>36.0 15.0 0.0 0 0 3.1416</pose><uri>model://victim_person</uri></include>
    <include><name>victim_w5</name><pose>43.0 -6.0 0.0 0 0 -1.5708</pose><uri>model://victim_person</uri></include>
    <include><name>victim_w6</name><pose>50.0 11.0 0.0 0 0 0.0</pose><uri>model://victim_person</uri></include>
    <include><name>victim_w7</name><pose>54.0 -15.0 0.0 0 0 1.5708</pose><uri>model://victim_person</uri></include>
    <include><name>victim_w8</name><pose>58.0 1.0 0.0 0 0 3.1416</pose><uri>model://victim_person</uri></include>
  </world>
</sdf>
