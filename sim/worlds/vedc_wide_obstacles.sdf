<?xml version="1.0" ?>
<!--
  The open water of vedc_wide_empty.sdf with flood debris (houses, a wreck, bamboo, poles, basket
  boats) and nobody in the water: the plans with the LiDAR avoiding.
  Area x 0..60 m, y -18..18 m (sim/tools/fleet_compare.py AREAS["wide_obstacles"]).
-->
<sdf version="1.9">
  <world name="vedc_wide_obstacles">
    <physics name="2ms" type="ignore">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.6 0.75 0.9</background>
      <sky></sky>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.6 0.6 0.6 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <pose>0 0 0 0 0 0</pose>
      <uri>model://vedc_waves</uri>
    </include>

    <include>
      <name>vedc_buoy</name>
      <pose>0 0 0 0 0 0</pose>
      <uri>model://vedc_buoy</uri>
    </include>


    <!-- A camera high above looking straight down, east to the right, north up: the whole area in
         one picture (sim/tools/record_media.py record, topic /vedc_wide/overview). -->
    <model name="overview">
      <static>true</static>
      <pose>30 0 66 0 1.5708 1.5708</pose>
      <link name="link">
        <sensor name="overview" type="camera">
          <always_on>1</always_on>
          <update_rate>2</update_rate>
          <topic>vedc_wide/overview</topic>
          <camera>
            <horizontal_fov>1.0</horizontal_fov>
            <image><width>1280</width><height>800</height></image>
            <clip><near>1</near><far>200</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- Debris of the flood for the LiDAR, at least 5 m from every person of vedc_wide.sdf and clear of the
         starts (x -6..0). -->
    <include><name>house_1</name><pose>22 9 0 0 0 0</pose><uri>model://flooded_house</uri></include>
    <include><name>storm_house_1</name><pose>40 -14 0 0 0 0</pose><uri>model://storm_house</uri></include>
    <include><name>wrecked_boat</name><pose>10 -6 0 0 0 0.3</pose><uri>model://wrecked_boat</uri></include>
    <include><name>bamboo_1</name><pose>33 -3 0 0 0 0</pose><uri>model://bamboo_clump</uri></include>
    <include><name>bamboo_2</name><pose>47 4 0 0 0 1.0</pose><uri>model://bamboo_clump</uri></include>
    <include><name>broken_pole_1</name><pose>6 8 0 0 0 2.4</pose><uri>model://broken_pole</uri></include>
    <include><name>basket_boat_1</name><pose>52 -6 0 0 0 0</pose><uri>model://basket_boat</uri></include>
    <include><name>basket_boat_2</name><pose>28 -12 0 0 0 1.0</pose><uri>model://basket_boat</uri></include>
  </world>
</sdf>
