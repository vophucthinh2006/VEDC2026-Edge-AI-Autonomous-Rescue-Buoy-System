<?xml version="1.0" ?>
<!--
  The lake of vedc_lake.sdf with two people instead of one, 3 m apart side by side, 32 m east of
  the start and 6.5 and 9.5 m north of it: both fit in one camera frame. For watching what the
  boat does with several people (run_boat.sh --world=two). Keep in step with vedc_lake.sdf;
  sim/tools/two_person_test.sh builds the same scene, and a second one, from that file.
-->
<sdf version="1.9">
  <world name="vedc_lake">
    <physics name="2ms" type="ignore">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.6 0.75 0.9</background>
      <sky></sky>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.6 0.6 0.6 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <pose>0 0 0 0 0 0</pose>
      <uri>model://vedc_waves</uri>
    </include>

    <include>
      <name>vedc_buoy</name>
      <pose>0 0 0 0 0 0</pose>
      <uri>model://vedc_buoy</uri>
    </include>

    <!-- Obstacles ahead and to the sides, inside the LD14's 8 m range on the way out. -->
    <include>
      <name>marker_1</name>
      <pose>12 1 0 0 0 0</pose>
      <uri>model://spherical_buoy</uri>
    </include>
    <include>
      <name>marker_2</name>
      <pose>20 -4 0 0 0 0</pose>
      <uri>model://spherical_buoy</uri>
    </include>
    <include>
      <name>marker_3</name>
      <pose>8 -10 0 0 0 0</pose>
      <uri>model://spherical_buoy</uri>
    </include>

    <!-- The person to find: 33 m out, north-east of the start (Gazebo x east, y north),
         facing west towards the start. victim_person is the realistic mesh the detector
         recognises; model://victim is a primitive stand-in that needs no download. -->
    <include>
      <name>victim</name>
      <pose>32 6.5 0 0 0 -1.5708</pose>
      <uri>model://victim_person</uri>
    </include>
    <!-- The second person, 3 m north of the first: both in the camera frame at once. -->
    <include>
      <name>victim_2</name>
      <pose>32 9.5 0 0 0 -1.5708</pose>
      <uri>model://victim_person</uri>
    </include>
  </world>
</sdf>
