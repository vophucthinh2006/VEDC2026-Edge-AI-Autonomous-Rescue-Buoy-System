+static float throttle_scale(float throttle) {
+    const float t = throttle > HEADING_SCALE_MIN_THROTTLE ? throttle : HEADING_SCALE_MIN_THROTTLE;
+    return t < HEADING_SCALE_REF_THROTTLE ? HEADING_SCALE_REF_THROTTLE / t : 1.0f;
+}
